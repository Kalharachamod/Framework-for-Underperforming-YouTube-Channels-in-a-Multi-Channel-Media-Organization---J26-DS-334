# Backend
# YouTube Data API v3 key: copy this file to .env and put the real key there (never here)
YOUTUBE_API_KEY=your_youtube_api_key_here
# Team-wide secret for pseudonymizing commenter ids (same for everyone, never change it):
#   python -c "import secrets; print(secrets.token_hex(32))"   then put the value in .env
COMMENTER_HASH_SALT=

# Supabase (shared online research database) - real values go in .env only
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-side PostgreSQL connection ("Session pooler" string); contains the DB password
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Shared research data layer (paths relative to the repository root)
DATA_DIR=data
DUCKDB_PATH=data/research.duckdb

# Frontend
VITE_API_URL=http://localhost:8000
