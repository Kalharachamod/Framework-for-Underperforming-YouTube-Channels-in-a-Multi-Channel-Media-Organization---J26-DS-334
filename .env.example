# Backend
# YouTube Data API v3 key: copy this file to .env and put the real key there (never here)
YOUTUBE_API_KEY=your_youtube_api_key_here
# Team-wide secret for pseudonymizing commenter ids (same for everyone, never change it):
#   python -c "import secrets; print(secrets.token_hex(32))"   then put the value in .env
COMMENTER_HASH_SALT=your_commenter_hash_salt_here

# Supabase (shared online research database) - real values go in .env only
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-side PostgreSQL connection ("Session pooler" string); contains the DB password
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-your-region.pooler.supabase.com:5432/postgres
# Separate restricted database roles; keep these out of the public app.
SUPABASE_ADMIN_DB_URL=postgresql://annotation_admin:your_admin_password@aws-0-your-region.pooler.supabase.com:5432/postgres
SUPABASE_IMPORT_DB_URL=postgresql://annotation_importer:your_import_password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Component 2 annotation portal
COMPONENT2_ANNOTATION_MODE=local
COMPONENT2_ANNOTATION_RUN_ID=component2_phase2a_20261014
COMPONENT2_ASSIGNMENT_SEED=20261014
COMPONENT2_PORTAL_SECRET=replace-with-a-long-random-server-secret
COMPONENT2_DB_CONNECT_TIMEOUT=10
# In approved production mode, set COMPONENT2_ANNOTATION_MODE=supabase and
# keep SUPABASE_DB_URL in Streamlit secrets or another server-side secret store.

# Shared research data layer (paths relative to the repository root)
DATA_DIR=data
DUCKDB_PATH=data/research.duckdb

# Backend API (read-only research results). No secrets needed.
# Comma-separated frontend origins allowed by CORS ("*" is refused)
API_CORS_ORIGINS=http://localhost:5173
API_MAX_PAGE_SIZE=100
API_REQUEST_TIMEOUT_SECONDS=30

# Frontend
VITE_API_URL=http://localhost:8000

# Component 1: restricted read-only PostgreSQL role (component1_readonly)
COMPONENT1_DB_URL=
