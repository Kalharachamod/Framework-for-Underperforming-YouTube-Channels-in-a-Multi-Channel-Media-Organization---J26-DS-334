# Backend
# YouTube Data API v3 key: copy this file to .env and put the real key there (never here)
YOUTUBE_API_KEY=your_youtube_api_key_here
# Team-wide secret for pseudonymizing commenter ids (same for everyone, never change it):
#   python -c "import secrets; print(secrets.token_hex(32))"   then put the value in .env
COMMENTER_HASH_SALT=

# Shared research data layer (paths relative to the repository root)
DATA_DIR=data
DUCKDB_PATH=data/research.duckdb

# Frontend
VITE_API_URL=http://localhost:8000
